NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=Vouchline <onboarding@resend.dev>
APP_URL=http://localhost:3000
# AI features (intro writer, plain-English search, resume import)
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-120b)
GROQ_MODEL=
CRON_SECRET=

# Sentry (free tier). Leave blank to run with no error monitoring --
# instrumentation.ts / instrumentation-client.ts both no-op without a DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (optional).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sign in with Apple (needs an Apple Developer account; see
# scripts/apple-client-secret.mjs). Leave unset to hide the button.
NEXT_PUBLIC_ENABLE_APPLE_SIGNIN=

# Push notifications (see scripts/generate-vapid-keys.mjs and migration 0045)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
PUSH_DISPATCH_SECRET=

# Shown on Privacy/Terms/Acceptable use as the contact address.
NEXT_PUBLIC_SUPPORT_EMAIL=
